##FILTER=<ID=REJ_AF_N,Description="Rejected by the caller (-p): normal allele frequency < 0.001 (-f)">
##FILTER=<ID=REJ_MinReads_N,Description="Rejected by the caller (-p): normal high-quality variant reads < 2 (-r)">
