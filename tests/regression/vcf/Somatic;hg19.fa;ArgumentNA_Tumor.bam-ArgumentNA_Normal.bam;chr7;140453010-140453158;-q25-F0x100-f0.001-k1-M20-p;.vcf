##FILTER=<ID=Cluster0bp,Description="Two somatic variants are within 0 bp">
##FILTER=<ID=LongAT,Description="The somatic variant is flanked by long A/T (>=14)">
##FILTER=<ID=REJ_AF_T,Description="Rejected by the caller (-p): tumour allele frequency < 0.001 (-f)">
##FILTER=<ID=REJ_MinReads_T,Description="Rejected by the caller (-p): tumour high-quality variant reads < 2 (-r)">
##FILTER=<ID=REJ_PMean_T,Description="Rejected by the caller (-p): tumour mean position in reads < 5 (-P)">
##FILTER=<ID=REJ_Qual_T,Description="Rejected by the caller (-p): tumour mean base quality < 25.0 (-q)">
##FILTER=<ID=REJ_RefMQ_T,Description="Rejected by the caller (-p): tumour AF < 0.25 and the variant's mean mapping quality is much lower than the reference allele's">
##FILTER=<ID=REJ_Splice_T,Description="Rejected by the caller (-p): tumour deletion matching a splice junction">
##FILTER=<ID=REJ_QRatio_T,Description="Rejected by the caller (-p): tumour high- to low-quality read ratio < 1.5 (-o)">
##FILTER=<ID=REJ_MQ_T,Description="Rejected by the caller (-p): tumour AF <= 0.3 and mean mapping quality < 0.0 (-O)">
##FILTER=<ID=REJ_MSI1_T,Description="Rejected by the caller (-p): tumour monomer microsatellite (MSI >= 15) and AF <= 0.25 (-mfreq)">
##FILTER=<ID=REJ_MSI_T,Description="Rejected by the caller (-p): tumour non-monomer microsatellite (MSI >= 12) and AF <= 0.1 (-nmfreq)">
