# Static analysis for src/ and tests/testkit (CI lint job: clang-tidy-20 on the compile_commands.json
# of a Clang build; the clang-analyzer-* checks run on release tags only). Every enabled check must
# be clean (WarningsAsErrors). Off as noise for this code base: easily swappable parameters,
# exception escape, switch default, optional access, enum size, std::endl, string concatenation
# and vector pre-allocation.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-switch-missing-default-case,
  -bugprone-unchecked-optional-access,
  cert-err33-c,
  cert-err34-c,
  cert-flp30-c,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  misc-redundant-expression,
  misc-unused-using-decls,
  misc-definitions-in-headers,
  misc-static-assert,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-redundant-void-arg,
  performance-*,
  -performance-enum-size,
  -performance-avoid-endl,
  -performance-inefficient-string-concatenation,
  -performance-inefficient-vector-operation,
  readability-container-size-empty,
  readability-duplicate-include,
  readability-misleading-indentation,
  readability-redundant-string-cstr,
  readability-string-compare,
WarningsAsErrors: '*'
HeaderFilterRegex: '(src|tests/testkit)/.*\.hpp$'
